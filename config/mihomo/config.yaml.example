# mihomo config — TEMPLATE. The real file lives on the router at
# /etc/mihomo/config.yaml; secrets are placeholders here. This file is the
# single source of truth for the `rules:` section (see scripts/deploy-whitelist.ps1).
#
# Design: mihomo does NOT touch system routing at all. Per-MAC traffic
# selection is done by nftables (router/wanguard.nft):
#   TCP       -> redirect to redir-port :7892 (below)
#   UDP / rest -> fwmark 300 -> ip rule 8000 -> table 500 -> TUN "Meta"
# TCP-into-TUN blackholes on some hardware (the SYN dies before it reaches
# the TUN fd, the kernel RSTs the client), so TCP goes through redir-port —
# the same non-TUN ingress class as mixed-port.

mixed-port: 7890
redir-port: 7892   # proxy-group TCP is redirected here by nft chain wanguard/redirect_c
allow-lan: true
external-controller: 0.0.0.0:9090
secret: "<DASHBOARD_SECRET>"
external-ui: ui
mode: rule
ipv6: false          # no v6 uplink anywhere; avoids hopeless v6 dials in DIRECT
log-level: warning     # warning floods only during outages (~300 lines/min); 4MB logd buffer (issue #21) absorbs ~90 min

tun:
  enable: true
  stack: gvisor        # TUN carries only the proxy group's UDP; gvisor is a proper L3 stack
  auto-route: false    # routing into TUN is done by ip rule fwmark 300 (wanguard)
  auto-redirect: false # global interception forbidden — per-MAC selection is wanguard's job
  dns-hijack:
    - any:53
  auto-detect-interface: true

# Sniffer: domain from TLS SNI / QUIC for connections intercepted by bare IP
sniffer:
  enable: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    TLS:
      ports:
        - 443
        - 8443
    QUIC:
      ports:
        - 443

dns:
  ipv6: false        # never hand AAAA to clients (empty answers)
  enable: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "+.<PROXY_PROVIDER_DOMAIN>"
  nameserver:
    - <PROVIDER_DNS_1>
    - <PROVIDER_DNS_2>
    - 77.88.8.8        # fallback resolvers (issue #22): keep DNS alive when the
    - 8.8.8.8          # primary provider's transit is down; egress follows main-table failover

proxies:
  - name: <PROXY_NAME>            # e.g. my-proxy-01
    type: hysteria2
    server: <PROXY_HOST>          # e.g. cdn.example.net
    port: <PROXY_PORT>            # e.g. 443
    password: <HYSTERIA2_PASSWORD>
    obfs: salamander
    obfs-password: <OBFS_PASSWORD>
    skip-cert-verify: false

rules:
  # YouTube
  - DOMAIN-SUFFIX,youtube.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,youtu.be,<PROXY_NAME>
  - DOMAIN-SUFFIX,ytimg.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,googlevideo.com,<PROXY_NAME>
  # OpenAI / ChatGPT / Gemini
  - DOMAIN-SUFFIX,openai.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,chatgpt.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,oaistatic.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,oaiusercontent.com,<PROXY_NAME>
  - DOMAIN,gemini.google.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,ai.google.dev,<PROXY_NAME>
  # Discord
  - DOMAIN-SUFFIX,discord.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,discord.gg,<PROXY_NAME>
  - DOMAIN-SUFFIX,discordapp.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,discordapp.net,<PROXY_NAME>
  - DOMAIN-SUFFIX,discord.media,<PROXY_NAME>
  # Meta (Instagram / Facebook)
  - DOMAIN-SUFFIX,instagram.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,cdninstagram.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,facebook.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,fbcdn.net,<PROXY_NAME>
  # WhatsApp (clients do not only talk to *.whatsapp.com/net and wa.me —
  # calls and media go to bare IPs from Meta's own allocations, AS32934,
  # hence the CIDRs below taken from RDAP/RIR data; v6 kept for the future,
  # same as Telegram)
  - DOMAIN-SUFFIX,whatsapp.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,whatsapp.net,<PROXY_NAME>
  - DOMAIN-SUFFIX,whatsapp.org,<PROXY_NAME>
  - DOMAIN-SUFFIX,whatsapp.biz,<PROXY_NAME>
  - DOMAIN-SUFFIX,wa.me,<PROXY_NAME>
  - IP-CIDR,31.13.24.0/21,<PROXY_NAME>,no-resolve
  - IP-CIDR,31.13.64.0/18,<PROXY_NAME>,no-resolve
  - IP-CIDR,45.64.40.0/22,<PROXY_NAME>,no-resolve
  - IP-CIDR,57.141.0.0/14,<PROXY_NAME>,no-resolve
  - IP-CIDR,57.145.0.0/16,<PROXY_NAME>,no-resolve
  - IP-CIDR,57.146.0.0/15,<PROXY_NAME>,no-resolve
  - IP-CIDR,57.148.0.0/15,<PROXY_NAME>,no-resolve
  - IP-CIDR,66.220.144.0/20,<PROXY_NAME>,no-resolve
  - IP-CIDR,69.63.176.0/20,<PROXY_NAME>,no-resolve
  - IP-CIDR,69.171.224.0/19,<PROXY_NAME>,no-resolve
  - IP-CIDR,74.119.76.0/22,<PROXY_NAME>,no-resolve
  - IP-CIDR,102.132.96.0/19,<PROXY_NAME>,no-resolve
  - IP-CIDR,103.4.96.0/22,<PROXY_NAME>,no-resolve
  - IP-CIDR,129.134.0.0/16,<PROXY_NAME>,no-resolve
  - IP-CIDR,157.240.0.0/16,<PROXY_NAME>,no-resolve
  - IP-CIDR,173.252.64.0/18,<PROXY_NAME>,no-resolve
  - IP-CIDR,179.60.192.0/22,<PROXY_NAME>,no-resolve
  - IP-CIDR,185.60.216.0/22,<PROXY_NAME>,no-resolve
  - IP-CIDR,204.15.20.0/22,<PROXY_NAME>,no-resolve
  - IP-CIDR6,2620:0:1c00::/40,<PROXY_NAME>,no-resolve
  - IP-CIDR6,2a03:2880::/29,<PROXY_NAME>,no-resolve
  # Telegram (desktop/mobile clients go to bare datacenter IP ranges, so
  # domain rules alone are not enough — DC CIDRs added)
  - DOMAIN-SUFFIX,telegram.org,<PROXY_NAME>
  - DOMAIN-SUFFIX,t.me,<PROXY_NAME>
  - DOMAIN-SUFFIX,telegram.me,<PROXY_NAME>
  - DOMAIN-SUFFIX,telegram.dog,<PROXY_NAME>
  - DOMAIN-SUFFIX,telegra.ph,<PROXY_NAME>
  - DOMAIN-SUFFIX,te.legra.ph,<PROXY_NAME>
  - DOMAIN-SUFFIX,telesco.pe,<PROXY_NAME>
  - DOMAIN-SUFFIX,tdesktop.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,cdn-telegram.org,<PROXY_NAME>
  - IP-CIDR,91.108.4.0/22,<PROXY_NAME>,no-resolve
  - IP-CIDR,91.108.8.0/22,<PROXY_NAME>,no-resolve
  - IP-CIDR,91.108.12.0/22,<PROXY_NAME>,no-resolve
  - IP-CIDR,91.108.16.0/22,<PROXY_NAME>,no-resolve
  - IP-CIDR,91.108.20.0/22,<PROXY_NAME>,no-resolve
  - IP-CIDR,91.108.56.0/22,<PROXY_NAME>,no-resolve
  - IP-CIDR,149.154.160.0/20,<PROXY_NAME>,no-resolve
  - IP-CIDR,95.161.64.0/20,<PROXY_NAME>,no-resolve
  - IP-CIDR6,2001:67c:4e8::/48,<PROXY_NAME>,no-resolve
  - IP-CIDR6,2001:b28:f23c::/48,<PROXY_NAME>,no-resolve
  - IP-CIDR6,2001:b28:f23d::/48,<PROXY_NAME>,no-resolve
  - IP-CIDR6,2001:b28:f23f::/48,<PROXY_NAME>,no-resolve
  - IP-CIDR6,2a0a:f280::/32,<PROXY_NAME>,no-resolve
  # LinkedIn
  - DOMAIN-SUFFIX,linkedin.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,licdn.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,lnkd.in,<PROXY_NAME>
  # X / Twitter (media — twimg.com, short links — t.co)
  - DOMAIN-SUFFIX,x.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,twitter.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,twimg.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,twttr.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,t.co,<PROXY_NAME>
  - DOMAIN-SUFFIX,twtrcdn.com,<PROXY_NAME>
  # Unraid OS updates + license (releases / api / account / keys)
  - DOMAIN-SUFFIX,unraid.net,<PROXY_NAME>
  - DOMAIN-SUFFIX,lime-technology.com,<PROXY_NAME>
  # Community Applications: plugin + appfeed are hosted on GitHub
  - DOMAIN-SUFFIX,github.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,githubusercontent.com,<PROXY_NAME>
  # Docker registries (CA pulls container images from here)
  - DOMAIN-SUFFIX,docker.io,<PROXY_NAME>
  - DOMAIN-SUFFIX,docker.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,ghcr.io,<PROXY_NAME>
  - DOMAIN-SUFFIX,lscr.io,<PROXY_NAME>
  # Custom additions (a media service; some public resolvers answer these
  # with a bare CNAME and no A record, so they are pinned here)
  - DOMAIN-SUFFIX,kino.watch,<PROXY_NAME>
  - DOMAIN-SUFFIX,cdn-service.space,<PROXY_NAME>
  - DOMAIN-SUFFIX,srvkp.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,staticpop.net,<PROXY_NAME>
  - DOMAIN-SUFFIX,kino.pub,<PROXY_NAME>
  # Adult + misc
  - DOMAIN-SUFFIX,pornhub.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,phncdn.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,redgifs.com,<PROXY_NAME>
  - DOMAIN-SUFFIX,warera.io,<PROXY_NAME>
  - DOMAIN-SUFFIX,ourdream.ai,<PROXY_NAME>
  # Everything else — DIRECT (via the default WAN)
  - MATCH,DIRECT
