# /etc/config/wanguard — the single source of truth for groups and membership.
# The whole data plane (nft sets/rules, ip rules, routing tables, routes) is
# rendered by `wanguard apply`. Readers/writers: wanguard CLI, luci-app-wanguard.
#
# A group is `config group '<name>'` (name = [A-Za-z0-9_]; members reference it):
#   option type 'direct'  + option iface '<netifd iface>'  -> egress via that interface
#   option type 'direct-lb' + list member_iface '<iface>'  -> balance across members
#       + option weight_<iface> '<%>' (absent/garbage/0 -> 50; member_live
#         is written by wand-tick failover — do not hand-edit)
#   option type 'proxy'                                    -> egress via mihomo (max 1)
# Allocation is automatic and deterministic:
#   proxy     = fwmark 300 / table 500 (fixed)
#   direct    = fwmark 100,200,400,... / tables 400,401,...
#   direct-lb = one slot per SORTED member_iface; the cascade continues after
#               the direct groups (marks >= 300 skip mihomo's 300)
#   (see docs/ARCHITECTURE.md §2 and §7.1)

config globals 'globals'
	option redir_port '7892'
	# the group wan-watch health-checks and bounces (default: 'a')
	option main_group 'a'
	# never mark/redirect traffic to these addresses
	# (admin channels, management endpoints — survive even a marked window)
	list no_mark '192.0.2.10'
	# WAN watchdog probe anchors (#23): the channel counts as UP while at
	# least `wan_reliability` of them answer (default 1 = any — DOWN only
	# when ALL fail). Legacy single options wan_anchor1/wan_anchor2 are
	# still read when the list is absent; when both are set, the list wins.
	# list wan_anchors 'http://www.gstatic.com/generate_204'
	# list wan_anchors 'http://detectportal.firefox.com/success.txt'
	# option wan_reliability '1'

config group 'a'
	option type 'direct'
	option iface 'vpn'

config group 'b'
	option type 'direct'
	option iface 'wan2'

# Load balance a client across two WANs (slots continue the cascade after
# a and b: wan1 = fwmark 400/table 402, wan3 = fwmark 500/table 403):
config group 'lb'
	option type 'direct-lb'
	list member_iface 'wan1'
	list member_iface 'wan3'
	option weight_wan1 '70'
	option weight_wan3 '30'

config group 'c'
	option type 'proxy'

config member 'm_001122334455'
	option name 'desktop-eth'
	option mac '00:11:22:33:44:55'
	option group 'c'

config member 'm_001122334466'
	option name 'desktop-wifi'
	option mac '00:11:22:33:44:66'
	option group 'c'

config member 'm_001122334477'
	option name 'laptop-lb'
	option mac '00:11:22:33:44:77'
	option group 'lb'

# Legacy (pre-#13): the `config wan 'wan'` section is no longer used by the
# current code; remove manually after migrating:
# config wan 'wan'
# 	option group_a 'ppp'
# 	option group_b 'pppoe'
