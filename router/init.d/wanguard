#!/bin/sh /etc/rc.common
# wanguard: per-MAC group routing (docs/ARCHITECTURE.md)
# Starts after mihomo (both START=99; S99mihomo < S99wanguard alphabetically).
START=99
STOP=10
USE_PROCD=1

NAME=wanguard
PROG=/usr/bin/wanguard-keepalive

start_service() {
    # nft skeleton first: marking must exist before any MAC is added to sets
    nft list table inet wanguard >/dev/null 2>&1 || nft -f /usr/share/wanguard/wanguard.nft
    # render everything from /etc/config/wanguard: sets, rules, ip rules,
    # per-group tables and routes (issue #13)
    /usr/bin/wanguard apply >/dev/null 2>&1 || true

    procd_open_instance "$NAME"
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
