#!/bin/sh
# mock uci for the wanguard test harness: state in $UCI_STATE
# (full-key lines `wanguard.a.iface=vpn`), section types in $UCI_SECTIONS
# (`a=group` lines). Emulates the exact subset the wanguard CLI uses:
#   uci -q get <key> | uci -q show <pkg> | uci set <k>=<v> | uci commit [pkg]
#   uci add_list <k>=<v> | uci delete <k>   (#26 backup_iface lists:
#     a list option is stored as repeated key=value lines; `get` joins
#     their values space-separated, like real uci does for lists)
STATE=${UCI_STATE:?UCI_STATE not set}
SECS=${UCI_SECTIONS:?UCI_SECTIONS not set}

q=""
if [ "$1" = "-q" ]; then q=1; shift; fi

case "$1" in
	get)
		key="$2"
		# join all lines of the key (a list option is repeated lines)
		vals=$(grep "^$key=" "$STATE" 2>/dev/null | sed "s/^$key=//" | tr '\n' ' ')
		vals=${vals% }
		if [ -n "$vals" ]; then
			printf '%s\n' "$vals"
			exit 0
		fi
		[ -n "$q" ] || echo "uci: Entry not found" >&2
		exit 1
		;;
	show)
		pkg="$2"
		while IFS= read -r line; do
			[ -n "$line" ] && printf '%s.%s\n' "$pkg" "$line"
		done < "$SECS"
		while IFS= read -r line; do
			[ -n "$line" ] && printf "%s='%s'\n" "${line%%=*}" "${line#*=}"
		done < "$STATE"
		exit 0
		;;
	set)
		arg="$2"
		key=${arg%%=*}
		val=${arg#*=}
		tmp="$STATE.new"
		grep -v "^$key=" "$STATE" > "$tmp" 2>/dev/null || : > "$tmp"
		printf '%s=%s\n' "$key" "$val" >> "$tmp"
		mv "$tmp" "$STATE"
		exit 0
		;;
	add_list)
		arg="$2"
		key=${arg%%=*}
		val=${arg#*=}
		printf '%s=%s\n' "$key" "$val" >> "$STATE"
		exit 0
		;;
	delete)
		key="$2"
		tmp="$STATE.new"
		grep -v "^$key=" "$STATE" > "$tmp" 2>/dev/null || : > "$tmp"
		mv "$tmp" "$STATE"
		exit 0
		;;
	commit|import|export|changes|revert)
		exit 0
		;;
	*)
		echo "mock uci: unsupported: $*" >&2
		exit 2
		;;
esac
